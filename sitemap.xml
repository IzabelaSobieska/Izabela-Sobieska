<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml

  Root sitemap for https://izabela-sobieska.com
  - Purpose: placed at repository root so the site serves it at /sitemap.xml.
  - If your deployment builds into a "dist" or "docs" folder, ensure the deployment
    copies this file into that published folder (see suggestions below).
  - To add more pages, add additional <url> entries (use absolute URLs, not fragments).
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
                      http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
>
  <!--
    Homepage entry
    - lastmod: set to the date of this change
    - changefreq: tells crawlers how often the content typically changes
    - priority: relative importance on the site
  -->
  <url>
    <loc>https://izabela-sobieska.com/</loc>
    <lastmod>2025-11-24</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!--
    Example: if you later have real pages (not anchor sections) add entries like:
    <url>
      <loc>https://izabela-sobieska.com/about</loc>
      <lastmod>2025-11-24</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
    </url>
  -->
</urlset>
